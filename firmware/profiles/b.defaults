# Profile B: lower threshold + audio clip for a person to confirm each alert.
# Threshold 0.60 (validation of job 5065: alarm F1 0.928, FPR 3.1 %).
# After every alert, 5 s before + 5 s after are sent as WAV over MQTT.
CONFIG_LOGGUARD_PROFILE="B"
CONFIG_LOGGUARD_THRESHOLD_PCT=60
CONFIG_LOGGUARD_AUDIO_CLIP=y
CONFIG_LOGGUARD_CLIP_PRE_S=5
CONFIG_LOGGUARD_CLIP_POST_S=5
